# Only The Finest — Base44 production configuration
#
# The Base44 App ID for the production storefront app.
# This is a public identifier (NOT a secret) — safe to ship in client builds.
EXPO_PUBLIC_BASE44_APP_ID=69ddebfc0f7c323042ac3a0c

# Optional: the app's own origin, used for login redirects.
# Defaults to the production storefront URL.
EXPO_PUBLIC_APP_BASE_URL=https://www.shoponlythefinest.com

# NOTE: The Shopify Storefront API token (shpat_...) is NEVER placed here or in
# client code. It lives only inside the Base44 server (server-side function env).
# The app talks to Shopify exclusively through Base44 server functions:
#   getShopifyProducts / getShopifyCollections / createCheckout
